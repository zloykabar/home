* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    -webkit-tap-highlight-color: transparent;
}

body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background: #0f0f1e;
    color: #e0e0e0;
    min-height: 100vh;
    padding: 16px;
    padding-bottom: 80px;
}

.app {
    max-width: 500px;
    margin: 0 auto;
}

.header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
}

.header h1 {
    font-size: 22px;
    background: linear-gradient(135deg, #667eea, #764ba2);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

.status {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    padding: 6px 10px;
    background: #1a1a2e;
    border-radius: 20px;
}

.dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #ff5252;
    animation: pulse 2s infinite;
}

.dot.online { background: #4caf50; animation: none; }
.dot.offline { background: #ff5252; }

@keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
}

.settings-card, .devices, .log {
    background: #1a1a2e;
    border-radius: 16px;
    padding: 16px;
    margin-bottom: 16px;
    border: 1px solid #252540;
}

h2 {
    font-size: 16px;
    margin-bottom: 12px;
    color: #a0a0c0;
}

label {
    display: block;
    font-size: 13px;
    color: #8888a8;
    margin: 10px 0 4px;
}

input {
    width: 100%;
    padding: 12px;
    background: #0f0f1e;
    border: 1px solid #2a2a45;
    border-radius: 10px;
    color: #e0e0e0;
    font-size: 15px;
    outline: none;
}

input:focus {
    border-color: #667eea;
}

.btn {
    width: 100%;
    padding: 14px;
    border: none;
    border-radius: 10px;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    margin-top: 12px;
    transition: transform 0.1s;
}

.btn:active { transform: scale(0.97); }

.btn.primary {
    background: linear-gradient(135deg, #667eea, #764ba2);
    color: white;
}

.device-card {
    background: #0f0f1e;
    border-radius: 12px;
    padding: 14px;
    margin-bottom: 12px;
    border: 1px solid #2a2a45;
}

.device-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
}

.device-name {
    font-weight: 600;
    font-size: 15px;
}

.device-id {
    font-size: 10px;
    color: #666;
    font-family: monospace;
    word-break: break-all;
    margin-bottom: 10px;
}

.device-state {
    font-size: 12px;
    padding: 4px 8px;
    border-radius: 12px;
    background: #2a2a45;
}

.device-state.on {
    background: #4caf5030;
    color: #4caf50;
}

.device-state.off {
    background: #ff525230;
    color: #ff5252;
}

.controls {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
}

.controls .btn {
    margin-top: 0;
    padding: 12px;
    font-size: 13px;
}

.btn.on-btn { background: #4caf50; color: white; }
.btn.off-btn { background: #ff5252; color: white; }

.brightness {
    grid-column: 1 / -1;
    margin-top: 8px;
}

.brightness label {
    margin: 0 0 6px;
}

input[type="range"] {
    width: 100%;
    -webkit-appearance: none;
    height: 6px;
    background: #2a2a45;
    border-radius: 3px;
    padding: 0;
    border: none;
}

input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #667eea;
    cursor: pointer;
}

.brightness-value {
    text-align: center;
    font-size: 12px;
    color: #8888a8;
    margin-top: 4px;
}

#logBox {
    font-family: monospace;
    font-size: 11px;
    max-height: 200px;
    overflow-y: auto;
    background: #0a0a14;
    padding: 10px;
    border-radius: 8px;
    color: #8888a8;
}

.log-line { padding: 2px 0; border-bottom: 1px solid #1a1a2e; }
.log-line.ok { color: #4caf50; }
.log-line.err { color: #ff5252; }
